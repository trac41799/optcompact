{
  "name": "@optcompact/dsh",
  "version": "0.3.0",
  "description": "DeepSeek Harness compaction policy plugin: model-driven when-to-compact over the stock compaction backend.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "dependencies": {
    "@optcompact/core": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/**/*.test.ts",
    "build": "tsc -b"
  }
}
